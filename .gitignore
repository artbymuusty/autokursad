# KURSAD40 runtime artifacts (mission logs, pid files, stray shell redirects)
.scripts/olds/v32/logs/
*.jsonl
# ISTISNA -- kalibrasyon kayitlari (2026-09-02). Bunlar bir kosunun gecici
# ciktisi DEGIL, ucus guvenligi esiklerinin ARKASINDAKI KANIT:
# real_system.yaml'daki vz_settle_m_s ve attitude_rate_limit_deg_s dogrudan
# bu olcumlerin p95'inden turetiliyor ve YAML yorumu ilgili dosya adina
# atif yapiyor (docs/climb-then-cruise-hw-checklist.md 1. bolum). Repoda
# olmazlarsa "bu esik nereden geldi" sorusu cevapsiz kalir.
# Kucukler: 60 s / 10 Hz bir olcum ~78 KB.
!.scripts/olds/v34/v34_flight_stack/logs/motion_noise_*.jsonl
*.pid
GZ_PARTITION=*
→

# KURSAD40 -- public depo kapsami (2026-09-01 karari)
# Kod, dokuman ve GOREV3_ALMA_DURUM.md'nin atif yaptigi GUNCEL kosu
# kanitlari depoya girer; eski kosu arsivleri ve yeniden uretilebilir
# ciktilar girmez. Not: *.jsonl zaten yukarida haric tutuluyor, mission
# olay akislarinin buyuk kismi bu yuzden hicbir zaman depoya girmedi.
.scripts/olds/*/logs/
.scripts/olds/*/demo/runs/2026083*/
# generate_competition_area.py'nin dondurdugu world yedekleri
*.sdf.bak.*

# 2026-09-01 kosularinin HAM kanitini geri al.
# Yukaridaki genel *.jsonl / *.log kurallari bu dizinleri de bosaltiyordu:
# klon tamlik denetiminde (2026-09-01) kosu dizinlerinde yalnizca summary.txt
# ve mission_positions_*.json kaldigi, oysa GOREV3_ALMA_DURUM.md'nin atif
# yaptigi sayilarin mission.log ve mission_*.jsonl icinde oldugu gorulduo.
# Rapordaki iddialar ham veriden dogrulanabilsin diye bu dort kosu geri
# aliniyor. Yeni kosular yine varsayilan olarak DISARIDA kalir.
!.scripts/olds/v34/demo/runs/20260901T*/**

# Yol temizligi yedegi: TEMIZLENMEMIS orijinalleri iceriyor (mutlak
# /Users/... yollari). Depoya girerse temizligin anlami kalmaz.
.scripts/olds/v34/backups/faz3_pathclean_*/
