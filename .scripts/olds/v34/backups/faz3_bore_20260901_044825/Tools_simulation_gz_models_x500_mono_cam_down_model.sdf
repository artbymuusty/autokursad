      <spring_reference>0</spring_reference>
    </dynamics>
  </axis>
  <axis2>
    <xyz expressed_in="__model__">0 1 0</xyz>
    <limit><lower>-1.2</lower><upper>1.2</upper></limit>
    <dynamics>
      <damping>0.0030</damping>
      <friction>0</friction>
      <spring_stiffness>0.004</spring_stiffness>
      <spring_reference>0</spring_reference>
    </dynamics>
  </axis2>
</joint>

<!--
  VINC: bu eklem KASITLI olarak fixed degil prismatic. Sabit uzunlukta bir ip
  bu araci calistiramaz, olculeri tutmuyor:
    arac yerdeyken base_link z=0.240, kanca ucunun alti z=0.060
    payload_red'in ustu z=0.050, yuvasinin ustu z=0.070
    gorevin alcaldigi GOREV3_DESCENT_ALTITUDE_M=0.30'da kanca ucu z=0.360
  yani 0.30 m'de kanca yukun 31 cm ustunde kalir; arac tamamen inse bile
  kanca ucu yukun ustunden 1 cm yukarida. Ipi 31 cm uzatmak da cozmez:
  o zaman arac indiginde kanca 25 cm YERIN ALTINDA olur, ki dunya SDF'sindeki
  F2 notu tam bu ic ice gecmenin DART'a payload'i 4.9 m oteye FIRLATTIRDIGINI
  kaydediyor. Cozum ipin uzayip kisalabilmesi: silindir zaten makara.

  Eksen model cercevesinde asagi (0 0 -1), yani POZITIF eklem konumu = ip
  salindi. 0.00 = tamamen cekili (kalkis/inis guvenli hali, kanca ucu
  base_link-0.180'de ve inis takimindan 4.6 cm yukarida).
  Ust sinir 0.35 m: 0.30 m irtifada yuvanin ustune (z=0.070) ulasmak icin
  gereken uzama 0.29 m, ustune biraz pay.
-->
<joint name="HookRopeJoint" type="prismatic">
  <parent>hook_winch_link</parent>
  <child>hook_rope_link</child>
  <axis>
    <xyz expressed_in="__model__">0 0 -1</xyz>
    <limit>
      <lower>0.0</lower>
      <!--
        0.50 -> 0.35: this is now the winch's USABLE LINE LENGTH, and with a
        hinged cord it is load-bearing rather than cosmetic.

        The mission commands HOOK_WINCH_EXTEND_M = 0.40 deliberately past the
        target and expects "physics stops it". A RIGID rope did stop it (its
        note records cmd 0.12 stalling at 0.059). A cord cannot: it buckles,
        the winch runs to the full commanded travel, and every extra
        centimetre becomes slack that shoves the grounded hook over.

        Reaching the payload deck from the mission's 0.30 m descent altitude
        needs 0.272 m of payout (base_link sits 0.24 above ground, the hook
        tip hangs 0.198 below base_link, the deck top is at 0.070). Capping at
        0.35 leaves 78 mm of margin for PX4's few-centimetre altitude error
        while keeping the worst-case slack small enough that the cord stays
        floppy instead of saturating its joint limits.

        THAT SATURATION IS THE WHOLE POINT of the +-1.2 rad segment limits
        above. Absorbing s metres of slack folds the cord to (0.183-s)/0.183
        of its length, needing ~acos(that) per joint; at +-0.7 rad the four
        joints ran out of travel and the chain turned into a rigid bent strut
        that transmitted the full 8 N of winch effort into the hook.
        MEASURED: +-0.7 tipped the hook to 77 deg, +-1.2 to 49 deg. Tightening
        the cord makes it worse, not better - bound the payout, not the bend.
      -->
      <upper>0.35</upper>
      <effort>8</effort>
      <velocity>0.5</velocity>
    </limit>
    <dynamics>
      <damping>2.0</damping>
      <friction>0.1</friction>
    </dynamics>
  </axis>
</joint>

<!--
  Vinc komutu: gz.msgs.Double olarak hedef uzama (metre) /hook/winch/cmd'ye.
  Kazanclar kucuk bir yuk icin secildi: hareketli link 0.015 kg, yerçekimi
  yalnizca 0.15 N cekiyor, o yuzden p_gain kilitli tutmaya fazlasiyla yeter;
  d_gain sarkmayi soner.
-->
<plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
  <joint_name>HookRopeJoint</joint_name>
  <topic>/hook/winch/cmd</topic>
  <p_gain>60.0</p_gain>
  <i_gain>0.5</i_gain>
  <d_gain>8.0</d_gain>
  <cmd_max>50</cmd_max>
  <cmd_min>-50</cmd_min>
</plugin>

<!--
  parent_link ARTIK EKLENTININ VARSAYILANI DEGIL, ve olmamali.
  HookAttachSystem.cc'nin varsayilani hook_rope_link; o link eskiden kancanin
  KENDISIYDI, ama ip artik menteseli bir zincir oldugu icin hook_rope_link
  sadece makaradan cikis noktasi. Varsayilan birakilsaydi alinan yuk kancaya
  degil ipin EN UST parcasina kaynaklanir, yani ipin yaninda havada asili
  kalirdi. Bu yuzden acikca hook_body_link yaziliyor.
  Diger topic'ler eklentinin varsayilanlariyla ayni ama yine de acikca
  yazildi: varsayilana guvenmek, eklentinin ileride degismesi halinde
  sessizce yanlis linke baglanmak demek olurdu.
-->
<plugin filename="libHookAttachSystem.so" name="hook_attach::HookAttachSystem">
  <parent_link>hook_body_link</parent_link>
  <child_link>link</child_link>
  <attach_topic>/hook/attach</attach_topic>
  <detach_topic>/hook/detach</detach_topic>
  <output_topic>/hook/state</output_topic>
</plugin>


    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0.085 0 .05 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>
  </model>
</sdf>
