<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="blue_square">
    <static>true</static>
    <pose>-2 -2 0.05 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>../../materials/meshes/square_blue_1m_2cm.stl</uri>
            <scale>2 2 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.04 0.10 0.28 1</ambient>
          <diffuse>0.00 0.55 1.00 1</diffuse>
          <specular>0.90 0.90 0.90 1</specular>
          <emissive>0.000 0.004 0.541 1</emissive>
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- Mesh is 1m scaled 2x2x1 (blue_hexagon's own pattern) -> visual
           footprint is 2 x 2 m. Collision box matches that scaled
           footprint exactly, same thin-above/thick-below shape as
           blue_hexagon/red_triangle/red_square. -->
      <collision name="collision">
        <pose>0 0 -0.047 0 0 0</pose>
        <geometry>
          <box><size>2 2 0.1</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
