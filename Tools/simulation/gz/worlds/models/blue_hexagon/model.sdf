<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="blue_hexagon">
    <static>true</static>
    <pose>-2 0 0.05 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>../../materials/meshes/hexagon_blue_1m_2cm.stl</uri>
            <scale>4 4 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.04 0.10 0.28 1</ambient>
          <diffuse>0.00 0.55 1.00 1</diffuse>   <!-- canlı “elektrik mavisi” -->
          <specular>0.90 0.90 0.90 1</specular> <!-- parlak yansıma -->
          <emissive>0.000 0.004 0.541 1</emissive>
          <!-- W1: <double_sided> was a child of <visual>, which is not a
               valid SDF location - Gazebo logged "XML Element[double_sided],
               child of element[visual], not defined in SDF" and copied it
               inertly, so double-sided rendering was never actually on. It
               belongs inside <material>. Colours are untouched. -->
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- W1: the collision used to be a 1x1 m box while the VISUAL is the
           1 m hexagon mesh scaled 5x5 - a 5 m x 4.33 m shape. So ~96% of
           the visible hexagon had no collision under it, and a payload
           released anywhere but the middle fell straight through the
           target. Measured on 2026-08-17: a payload-equivalent cylinder
           dropped at the centre settles at z=0.081 (resting on the target),
           the same cylinder dropped 1.5 m out passes z=-1.08 and keeps
           going. The box now matches the scaled visual's footprint exactly
           (5 x 4.33), and is thin (6 mm) so the target still reads as
           ground marking rather than a kerb. -->
      <!-- Thin ABOVE, thick BELOW. A 6 mm-thick plate was tried first and
           measured worse: a payload falling from 1 m hits at ~4.4 m/s, which
           is several millimetres per physics step, so it TUNNELS straight
           through - 0.4/0.8/1.2/1.5/2.2 m offsets all ended at -17 to -32 m
           while only a dead-centre drop happened to catch. The box is now
           100 mm thick and offset downward so its TOP sits at world z=0.006,
           3 mm proud of the visual plane (no z-fighting with the payload's
           bottom face) while the bulk extends underground where it is
           invisible and cannot be tunnelled through. -->
      <!-- SCALE CORRECTED 5 -> 2 (2026-08-29): the 5x5 scale above (and the
           5 x 4.33 collision footprint the two comments above describe) was
           a v32-era leftover with no spec basis - the competition spec
           calls for a 2 m hexagon. Scale and this box are updated together
           (2 x 1.732, same 0.866 flat-to-flat ratio); the tunnelling
           measurement and thickness reasoning above are unaffected by the
           footprint's size and remain accurate. -->
      <!-- GOREV K / A (2026-09-04), OPERATOR SPEC: olcu KENAR uzunlugu.
           "Mavi Altigen: her kenar 2 m". Duzgun altigende kenar = cevrel
           yaricap, yani kenar 2 m -> kose-kose 4 m, duz-duz 3.464 m.
           Mesh (hexagon_blue_1m_2cm.stl) 1 m kose-kose olcusunde, yani
           kenari 0.5 m; scale 2 iken kenar 1 m idi -> scale 4 ile kenar
           2 m. Collision ayni oranda buyudu (4 x 3.464, 0.866 orani ayni).
           2026-08-29'daki "2 m hexagon" ifadesi kose-koseyi kastediyordu;
           operator spec'i kenar cinsinden verdi ve bu satir onu izliyor. -->
      <collision name="collision">
        <pose>0 0 -0.047 0 0 0</pose>
        <geometry>
          <box><size>4 3.464 0.1</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
