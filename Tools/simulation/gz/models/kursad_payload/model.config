<?xml version="1.0"?>
<model>
  <name>kursad_payload</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>KURSAD40</name>
  </author>
  <description>
    Payload Capture Body V1 as exported from Fusion
    (Payload_Capture_Body_V1). 142 x 52 x 70 mm, bottom plate + cage body with
    the central hook receiver on the deck.

    Geometry is NOT authored here; the meshes are generated from
    ~/KURSAD40/cad_exports/payload/ by
    Tools/simulation/gz/cad/update_hook_from_cad.sh.

    Model frame matches the CAD frame: the link origin is the CAD origin, so
    the body spans z in [-0.043, +0.027] m. The MISSION payloads
    (payload_red / payload_blue) are defined in
    Tools/simulation/gz/worlds/default.sdf and reference these same meshes
    directly - this model is the neutral/inspection copy.
  </description>
</model>
