<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    Neutral / inspection copy of the Fusion payload capture body.

    The MISSION copies are payload_red and payload_blue in
    Tools/simulation/gz/worlds/default.sdf: they are held to the vehicle by
    DetachableJoint (ADR-011) and must keep their exact detector colours, so
    they are declared there rather than included from here. They reference the
    SAME meshes/, so CAD updates reach all three copies at once.

    UNITS: metres. mm->m is baked into the vertices by cad_to_gz.py.
  -->
  <model name="kursad_payload">
    <static>false</static>
    <link name="link">
      <gravity>true</gravity>
      <inertial>
        <!-- Sim mass, NOT the real 1.05 kg - see the payload_red note in the
             world SDF for why the simulated payloads are 0.15 kg. -->
        <mass>0.15</mass>
        <inertia>
          <ixx>9.25e-5</ixx><iyy>3.06e-4</iyy><izz>2.76e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry><mesh><uri>model://kursad_payload/meshes/payload_body.stl</uri></mesh></geometry>
        <material>
          <ambient>0.45 0.45 0.48 1</ambient>
          <diffuse>0.60 0.60 0.63 1</diffuse>
        </material>
      </visual>
      <visual name="bottom_plate_visual">
        <geometry><mesh><uri>model://kursad_payload/meshes/payload_bottom_plate.stl</uri></mesh></geometry>
        <material>
          <ambient>0.25 0.25 0.27 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
        </material>
      </visual>

      <!-- YUVA (BORE) COLLISION.
           Buradaki bloklar generate_bore_collision.py tarafindan URETILIR;
           marker'lar arasini elle duzenlemeyin. Profil (cep O46.50, pah-1
           23.20 derece, pah-2 46.97 derece, gecis deligi O22.00) ve faset
           sayisi N o script'te tek yerde tanimli.

           ONCEKI HALI tek bir kutuydu: <box><size>0.142 0.052 0.070</size></box>.
           O kutunun ust yuzeyi deck seviyesinde DUZ ve KAPALI oldugu icin
           kanca burnu yuvaya giremiyor, kapagin ustunde duruyordu; yanal
           kacisi engelleyen hicbir fiziksel sinir yoktu. Geometri zaten
           payload_body.stl icinde VARDI ve VISUAL olarak kullaniliyordu,
           yalnizca collision tarafinda atiliyordu. Uydurulmus bir sey
           eklenmedi; var olan yuzeyler tasindi. -->
      <!-- KURSAD_BORE_COLLISION_START -->
      <!-- URETILMIS BLOK -- generate_bore_collision.py yazar.
           ELLE DUZENLEME. Profil ve N o script'te tek yerde.
           Faset N=12, deck serit K=8, 83 kutu.
           CAD yuva: cep O46.50 (10.5mm derin), pah-1 23.20deg,
           pah-2 46.97deg, gecis deligi O22.00.
           Burun (O26, r 13.00) link z +19.14'de durur
           -> maks. girme 15.86 mm. Yanal sinir 10.25 mm. -->
      <collision name="bore_base">
        <pose>0.000000 0.000000 -0.017000 0.000000000 0.000000000 0.000000000</pose>
        <geometry><box><size>0.142000 0.052000 0.052000</size></box></geometry>
      </collision>
